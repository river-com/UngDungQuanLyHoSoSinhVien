<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_main"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Profile Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_avatar"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@string/btn_change_avatar" />

                <!-- Student Info Table -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Họ và tên -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_name"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#424242" />

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nguyễn Ngọc Huy"
                            android:textSize="16sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- MSSV -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_mssv"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#424242" />

                        <TextView
                            android:id="@+id/tvMssv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2415053122119"
                            android:textSize="16sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Lớp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_class"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#424242" />

                        <TextView
                            android:id="@+id/tvClass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="24T1"
                            android:textSize="16sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- GPA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_gpa"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#424242" />

                        <TextView
                            android:id="@+id/tvGpa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="3.2"
                            android:textSize="16sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons Section -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_edit_profile"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnChangeAvatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_change_avatar"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_call"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnRequestCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_request_camera"
            android:textSize="15sp"
            android:padding="12dp"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>
